{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auriga:kb/rule.schema.json",
  "title": "Auriga knowledge-base rule",
  "description": "One rule per YAML file in kb/rules. Rules match only on structured, locale-independent data (hardware IDs, registry keywords, event provider/ID/data), never on display text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "severity", "confidence", "category", "scope", "summary", "explanation", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 80 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "severity": { "enum": ["info", "warning", "problem"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "confidence_note": { "type": "string", "description": "Why the confidence is what it is; shown next to the finding." },
    "category": { "enum": ["network", "display", "storage", "power", "audio", "bluetooth", "usb", "stability", "driver", "other"] },
    "scope": {
      "enum": ["device", "system"],
      "description": "device: evaluated once per device matching `match`. system: evaluated once."
    },
    "match": { "$ref": "#/$defs/selector" },
    "when": { "$ref": "#/$defs/condition" },
    "summary": { "type": "string", "description": "One line. `{device}` is replaced by the device name." },
    "explanation": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "kind": { "enum": ["vendor", "microsoft", "community", "observation"] }
        }
      }
    },
    "fixes": { "type": "array", "items": { "$ref": "#/$defs/fix" } }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "device" } } },
      "then": { "required": ["match"] }
    },
    {
      "if": { "properties": { "scope": { "const": "system" } } },
      "then": { "not": { "required": ["match"] } }
    }
  ],
  "$defs": {
    "patterns": {
      "description": "Case-insensitive regular expressions; any may match.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "class": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Setup class names (e.g. Net), exact, case-insensitive." },
        "hardware_id": { "$ref": "#/$defs/patterns", "description": "Matched against every hardware ID of the device." },
        "exclude_hardware_id": { "$ref": "#/$defs/patterns", "description": "Device is skipped if any hardware ID matches." },
        "compatible_id": { "$ref": "#/$defs/patterns" },
        "service": { "$ref": "#/$defs/patterns" },
        "enumerator": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "driver_provider": { "$ref": "#/$defs/patterns" },
        "include_not_present": { "type": "boolean", "default": false }
      }
    },
    "window": {
      "type": "object",
      "properties": {
        "min": { "type": "integer", "minimum": 1, "default": 1 },
        "days": { "type": "integer", "minimum": 1, "description": "Only events within this many days before the scan." },
        "device": { "enum": ["self", "any"], "default": "self", "description": "self: event attributed to the matched device (device scope only)." }
      }
    },
    "condition": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "not": { "$ref": "#/$defs/condition" },
        "signal": {
          "allOf": [{ "$ref": "#/$defs/window" }],
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["bugcheck", "unexpectedShutdown", "whea", "liveKernelEvent", "displayTdr", "storageReset", "deviceStartFailure", "driverInstallFailure", "wlanDisconnect", "wifiDriverWarning", "updateInstallFailure"]
            }
          }
        },
        "event": {
          "allOf": [{ "$ref": "#/$defs/window" }],
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["provider"],
          "properties": {
            "provider": { "$ref": "#/$defs/patterns" },
            "ids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
            "channel": { "type": "string" },
            "max_level": { "type": "integer", "minimum": 1, "maximum": 5, "description": "1 critical, 2 error, 3 warning, 4 info." },
            "data": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Named EventData fields that must equal these values (case-insensitive)." }
          }
        },
        "property": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keyword"],
          "minProperties": 2,
          "properties": {
            "keyword": { "type": "string", "minLength": 1, "description": "Registry keyword under Ndi\\params, not the display name." },
            "equals": { "type": "string" },
            "not_equals": { "type": "string" },
            "in": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "not_in": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "exists": { "type": "boolean" }
          }
        },
        "problem_code": {
          "description": "Device has one of these CM_PROB codes; empty list means any problem code.",
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow_turn_off"],
          "properties": { "allow_turn_off": { "type": "boolean" } }
        },
        "driver": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "provider": { "$ref": "#/$defs/patterns" },
            "inbox": { "type": "boolean", "description": "Driver INF is an inbox INF (not oemNN.inf)." },
            "version_below": { "type": "string", "pattern": "^\\d+(\\.\\d+)*$" },
            "version_at_least": { "type": "string", "pattern": "^\\d+(\\.\\d+)*$" },
            "signature": { "type": "array", "minItems": 1, "items": { "enum": ["valid", "testSigned", "invalid", "notSigned", "unknown"] } },
            "older_than_days": { "type": "integer", "minimum": 1, "description": "INF DriverVer date older than this many days before the scan." }
          }
        },
        "match_level": { "type": "array", "minItems": 1, "items": { "enum": ["good", "info", "warn", "bad"] } },
        "device_present": { "$ref": "#/$defs/selector", "description": "Some other present device matches this selector." },
        "setupapi_failure": { "type": "object", "allOf": [{ "$ref": "#/$defs/window" }], "unevaluatedProperties": false },
        "dump_files": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "min": { "type": "integer", "minimum": 1 } }
        }
      },
      "additionalProperties": false
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "risk", "action"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string" },
        "why": { "type": "string" },
        "tradeoff": { "type": "string", "description": "What you give up, shown before applying." },
        "risk": { "enum": ["low", "medium", "high"] },
        "optional": { "type": "boolean", "default": false },
        "action": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "adapter_property": {
              "type": "object",
              "additionalProperties": false,
              "required": ["keyword", "value"],
              "properties": {
                "keyword": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "description": "Raw registry value, e.g. \"3\"; must be offered by the driver on this machine." }
              }
            },
            "device_power": {
              "type": "object",
              "additionalProperties": false,
              "required": ["allow_turn_off"],
              "properties": { "allow_turn_off": { "type": "boolean" } }
            },
            "rollback_driver": { "type": "object", "additionalProperties": false, "properties": {} },
            "guided": {
              "type": "object",
              "additionalProperties": false,
              "required": ["steps"],
              "properties": {
                "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "page": { "enum": ["updates", "devices", "logs"] }
              }
            }
          }
        }
      }
    }
  }
}
